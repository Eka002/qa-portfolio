{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qa-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://qa-portfolio.dediashkina.workers.dev"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
